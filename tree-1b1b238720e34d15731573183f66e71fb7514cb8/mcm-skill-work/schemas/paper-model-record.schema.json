{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mcm.invalid/schemas/paper-model-record.schema.json",
  "title": "Protocol v2 per-paper formula-level model record",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "problem_type",
    "year",
    "source_sha256",
    "models",
    "dependency_edges",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "paper_id": {"type": "string", "pattern": "^P-[A-F]-"},
    "problem_type": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "year": {"type": "string", "pattern": "^(?:19|20)\\d{2}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modelUnit"}},
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_model_id", "to_model_id", "handoff"],
        "properties": {
          "from_model_id": {"type": "string"},
          "to_model_id": {"type": "string"},
          "handoff": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "review_status": {"enum": ["draft", "source-checked", "validated"]}
  },
  "additionalProperties": false,
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonemptyStringArray": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "variable": {
      "type": "object",
      "required": ["symbol", "normalized_name", "role", "unit", "definition", "source_status"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "normalized_name": {"type": "string", "minLength": 1},
        "role": {"enum": ["input", "state", "parameter", "intermediate", "output"]},
        "unit": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["explicit-defined", "inferred-from-equation", "unspecified"]}
      },
      "additionalProperties": false
    },
    "equation": {
      "type": "object",
      "required": [
        "equation_id", "page", "label", "source_expression", "normalized_latex",
        "purpose", "variable_symbols", "source_type", "visual_checked", "transcription_confidence"
      ],
      "properties": {
        "equation_id": {"type": "string", "pattern": "^EQ-[A-F]-"},
        "page": {"type": "integer", "minimum": 1},
        "label": {"type": ["string", "null"]},
        "source_expression": {"type": "string", "minLength": 1},
        "normalized_latex": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "variable_symbols": {"$ref": "#/$defs/nonemptyStringArray"},
        "source_type": {"enum": ["paper", "reconstructed", "extension"]},
        "visual_checked": {"const": true},
        "transcription_confidence": {"enum": ["high", "medium", "low"]}
      },
      "additionalProperties": false
    },
    "presence": {
      "type": "object",
      "required": ["status", "details"],
      "properties": {
        "status": {"enum": ["present", "omitted-by-paper", "not-applicable", "uncertain"]},
        "details": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "modelUnit": {
      "type": "object",
      "required": [
        "model_id", "page", "section", "family", "purpose", "base_or_modification", "summary",
        "variables", "inputs", "outputs", "governing_equations", "equation_status", "objectives",
        "constraints", "conditions", "parameter_estimation", "algorithm", "assumptions",
        "identifiability_feasibility", "handoff_outputs", "validation_refs", "computational_cost",
        "strengths", "limitations", "missing_details"
      ],
      "properties": {
        "model_id": {"type": "string", "pattern": "^MU-[A-F]-"},
        "page": {"type": "integer", "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "base_or_modification": {"enum": ["base", "modification", "hybrid", "paper-specific"]},
        "summary": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variable"}},
        "inputs": {"$ref": "#/$defs/stringArray"},
        "outputs": {"$ref": "#/$defs/stringArray"},
        "governing_equations": {"type": "array", "items": {"$ref": "#/$defs/equation"}},
        "equation_status": {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["present", "omitted-by-paper", "not-applicable", "uncertain"]},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "objectives": {"$ref": "#/$defs/nonemptyStringArray"},
        "constraints": {"$ref": "#/$defs/nonemptyStringArray"},
        "conditions": {
          "type": "object",
          "required": ["initial", "boundary", "equilibrium"],
          "properties": {
            "initial": {"$ref": "#/$defs/presence"},
            "boundary": {"$ref": "#/$defs/presence"},
            "equilibrium": {"$ref": "#/$defs/presence"}
          },
          "additionalProperties": false
        },
        "parameter_estimation": {
          "type": "object",
          "required": ["status", "method", "parameters"],
          "properties": {
            "status": {"enum": ["implemented", "partial", "omitted-by-paper", "not-applicable", "uncertain"]},
            "method": {"type": "string", "minLength": 1},
            "parameters": {"$ref": "#/$defs/stringArray"}
          },
          "additionalProperties": false
        },
        "algorithm": {
          "type": "object",
          "required": ["status", "steps", "software", "convergence_criteria"],
          "properties": {
            "status": {"enum": ["implemented", "partial", "omitted-by-paper", "not-applicable", "uncertain"]},
            "steps": {"$ref": "#/$defs/stringArray"},
            "software": {"$ref": "#/$defs/stringArray"},
            "convergence_criteria": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "assumptions": {"$ref": "#/$defs/nonemptyStringArray"},
        "identifiability_feasibility": {
          "type": "object",
          "required": ["status", "analysis"],
          "properties": {
            "status": {"enum": ["demonstrated", "partial", "not-demonstrated", "uncertain"]},
            "analysis": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "handoff_outputs": {"$ref": "#/$defs/stringArray"},
        "validation_refs": {"$ref": "#/$defs/nonemptyStringArray"},
        "computational_cost": {"type": "string", "minLength": 1},
        "strengths": {"$ref": "#/$defs/nonemptyStringArray"},
        "limitations": {"$ref": "#/$defs/nonemptyStringArray"},
        "missing_details": {"$ref": "#/$defs/nonemptyStringArray"}
      },
      "additionalProperties": false
    }
  }
}
