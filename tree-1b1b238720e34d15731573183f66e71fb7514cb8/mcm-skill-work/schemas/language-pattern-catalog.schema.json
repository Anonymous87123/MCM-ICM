{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mcm.invalid/schemas/language-pattern-catalog.schema.json",
  "title": "Evidence-backed MCM language pattern catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "problem_type",
    "templates",
    "lexicon",
    "layout_profiles"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "catalog_id": {"type": "string", "minLength": 1},
    "problem_type": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/template"}
    },
    "lexicon": {
      "type": "object",
      "required": ["positive", "negative"],
      "properties": {
        "positive": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "negative": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "layout_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/layoutProfile"}
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "required": [
        "pattern_id",
        "pattern_kind",
        "lifecycle",
        "problem_types",
        "chapters",
        "function",
        "trigger",
        "paragraph_moves",
        "slots",
        "variants",
        "filled_example",
        "forbidden_uses",
        "evidence",
        "source_count",
        "confidence",
        "judge_relevance"
      ],
      "properties": {
        "pattern_id": {"type": "string", "pattern": "^LP-[A-F]-[A-Z0-9-]+$"},
        "pattern_kind": {
          "enum": ["sentence-template", "paragraph-chain", "transition", "claim-frame"]
        },
        "lifecycle": {
          "enum": [
            "seed",
            "candidate",
            "corroborated",
            "bounded",
            "operationalized",
            "promoted",
            "challenged",
            "revised",
            "retired"
          ]
        },
        "problem_types": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["A", "B", "C", "D", "E", "F"]}
        },
        "chapters": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "function": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "paragraph_moves": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slot"}},
        "variants": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "filled_example": {"type": "string", "minLength": 1},
        "forbidden_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidence"}},
        "source_count": {"type": "integer", "minimum": 2},
        "confidence": {"enum": ["high", "medium", "low"]},
        "judge_relevance": {"$ref": "#/$defs/judgeRelevance"}
      }
    },
    "slot": {
      "type": "object",
      "required": ["name", "required", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "required": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "language_unit_id",
        "paper_id",
        "problem_type",
        "page",
        "section",
        "excerpt"
      ],
      "properties": {
        "language_unit_id": {"type": "string", "pattern": "^LU-[A-F]-"},
        "paper_id": {"type": "string", "pattern": "^P-[A-F]-"},
        "problem_type": {"enum": ["A", "B", "C", "D", "E", "F"]},
        "page": {"type": "integer", "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "judgeRelevance": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": {"enum": ["direct-evidence", "correlational", "unknown"]},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "layoutProfile": {
      "type": "object",
      "required": [
        "chapter",
        "unit",
        "measurement_status",
        "sample_papers",
        "sample_size",
        "observed_range",
        "recommended_use"
      ],
      "properties": {
        "chapter": {"type": "string", "minLength": 1},
        "unit": {"enum": ["sentence", "paragraph", "word", "page-fraction"]},
        "measurement_status": {"enum": ["provisional", "validated"]},
        "sample_papers": {"type": "array", "minItems": 2, "uniqueItems": true},
        "sample_size": {"type": "integer", "minimum": 2},
        "observed_range": {
          "type": "object",
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "number", "minimum": 0},
            "maximum": {"type": "number", "minimum": 0}
          }
        },
        "recommended_use": {"type": "string", "minLength": 1}
      }
    }
  }
}
