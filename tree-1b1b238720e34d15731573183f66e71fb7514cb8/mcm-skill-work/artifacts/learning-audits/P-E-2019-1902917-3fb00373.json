  "main_argument_chains": [
   {
    "claim": "the short run cost of a project is its construction cost plus the replacement cost of the pollution beyond what nature handles",
    "support_steps": [
     "split the pollution into solid waste, water and air",
     "subtract the self-purification",
     "multiply by the treatment cost"
    ],
    "decision_consequence": "reject a project whose replacement cost exceeds its benefit",
    "source_pages": [
     6,
     14
    ]
   },
