    "claim": "the long run cost can be scored by a hierarchy and compared with a scored benefit",
    "support_steps": [
     "measure five indicators",
     "weight them by a comparison matrix",
     "take the inner product with the ranks"
    ],
    "decision_consequence": "accept a project whose benefit score exceeds its cost score",
