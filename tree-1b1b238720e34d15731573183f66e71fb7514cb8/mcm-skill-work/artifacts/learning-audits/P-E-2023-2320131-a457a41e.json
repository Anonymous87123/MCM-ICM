    "main_argument_chains": [
      {
        "claim": "A raster of commercial, residential, industrial, and empty grids builds a light-pollution index that weights damage at 85.73 percent, then widens it by a kernel that sums to one. On Saskatoon the average risk is 0.0665 on protected land, 0.1529 in a rural community, 0.2726 in the suburbs, and 0.3397 in the city. Regulation, which cuts luminance 1 percent and the other lighting terms 3 percent per intensity step, lowers the risk more than a tax, and the tax rebounds if it is pushed too far.",
        "support_steps": [
          "Score damage, balance, and time, and weight them by entropy",
          "Widen the index by the neighbors, with a kernel that sums to one",
          "Price the night economy, bend Gleason diversity into an s-curve, and drop crime",
          "Move grids only when eight neighbors match, then set the move aside as too costly",
          "Compare regulation and compensation at the same intensity"
        ],
        "decision_consequence": "Regulate outdoor light, keep any tax moderate, and do not rearrange a city that is already built.",
        "source_pages": [
          9,
          14,
          20,
          23
        ]
      }
    ],
