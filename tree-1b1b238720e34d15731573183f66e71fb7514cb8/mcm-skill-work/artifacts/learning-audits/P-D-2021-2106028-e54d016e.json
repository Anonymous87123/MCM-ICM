    "main_argument_chains": [
      {
        "claim": "Influence is a weighted mix of five network views, not one.",
        "support_steps": [
          "define betweenness and eigenvector centrality",
          "count three generations",
          "split loyalty evenly",
          "weight by entropy"
        ],
        "decision_consequence": "A single centrality would have hidden genre diversity and loyalty, which move the ranking.",
        "source_pages": [
          5,
          6,
          7,
          8
        ]
      },
      {
        "claim": "Raw distance is the wrong similarity, and a three-factor space fixes it.",
        "support_steps": [
          "correlate the features",
          "reject Euclidean distance",
          "fit the factor model",
          "average cosine by genre"
        ],
        "decision_consequence": "Staying in the raw space would have double-counted correlated features and blurred the clusters.",
        "source_pages": [
          9,
          10,
          11
        ]
      },
