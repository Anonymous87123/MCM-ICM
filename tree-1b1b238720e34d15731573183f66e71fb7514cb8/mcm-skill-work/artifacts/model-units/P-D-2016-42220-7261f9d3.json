        },
        {
          "symbol": "eps",
          "normalized_name": "confidence_bound",
          "unit": "index",
          "definition": "maximum opinion gap that still allows spread",
          "role": "parameter",
          "source_status": "explicit-defined"
        },
        {
          "symbol": "mu",
          "normalized_name": "update_weight",
          "unit": "index",
          "definition": "fraction of the gap closed at each step",
          "role": "parameter",
          "source_status": "explicit-defined"
        },
        {
          "symbol": "phio",
          "normalized_name": "public_opinion",
          "unit": "index",
