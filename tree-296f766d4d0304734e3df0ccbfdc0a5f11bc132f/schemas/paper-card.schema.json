{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mcm.invalid/schemas/paper-card.schema.json",
  "title": "Sequential MCM paper card",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "problem_type",
    "year",
    "source",
    "source_quality",
    "task_reconstruction",
    "section_map",
    "contributions",
    "dependency_graph",
    "assumptions",
    "data_and_preprocessing",
    "models",
    "verification",
    "results_trace",
    "writing_logic",
    "language_observations",
    "visualization_observations",
    "judge_relevance_hypotheses",
    "weaknesses",
    "independent_extensions",
    "candidate_rule_impacts",
    "unresolved_questions",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "paper_id": {"type": "string", "pattern": "^P-[A-F]-"},
    "problem_type": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "year": {"type": "string", "pattern": "^(?:19|20)\\d{2}$"},
    "protocol_v2_records": {
      "type": "object",
      "required": ["language", "models"],
      "properties": {
        "language": {
          "type": "object",
          "required": ["path", "schema_version", "unit_count", "chapters", "review_status"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "schema_version": {"enum": [2, 3]},
            "unit_count": {"type": "integer", "minimum": 1},
            "chapters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "review_status": {"enum": ["draft", "source-checked", "validated"]}
          },
          "additionalProperties": false
        },
        "models": {
          "type": "object",
          "required": ["path", "model_count", "equation_count", "review_status"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "model_count": {"type": "integer", "minimum": 1},
            "equation_count": {"type": "integer", "minimum": 0},
            "review_status": {"enum": ["draft", "source-checked", "validated"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["relative_path", "sha256", "page_count"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "source_quality": {
      "type": "object",
      "required": ["text_fidelity", "layout_reviewed", "equations_reviewed", "figures_reviewed", "limitations"],
      "properties": {
        "text_fidelity": {"enum": ["high", "medium", "low", "ocr-required"]},
        "layout_reviewed": {"type": "boolean"},
        "equations_reviewed": {"type": "boolean"},
        "figures_reviewed": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "task_reconstruction": {"type": "object"},
    "section_map": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "contributions": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "dependency_graph": {"type": "object"},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "data_and_preprocessing": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "models": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "verification": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "results_trace": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "writing_logic": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "language_observations": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "visualization_observations": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "judge_relevance_hypotheses": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "weaknesses": {"type": "array", "items": {"$ref": "#/$defs/pageAnchoredObject"}},
    "independent_extensions": {"type": "array", "items": {"type": "object"}},
    "candidate_rule_impacts": {"type": "array", "items": {"type": "object"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["draft", "source-checked", "validated"]}
  },
  "$defs": {
    "pageAnchoredObject": {
      "type": "object",
      "required": ["page", "summary"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "section": {"type": ["string", "null"]},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
