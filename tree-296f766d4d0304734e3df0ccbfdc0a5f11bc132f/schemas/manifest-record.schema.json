{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mcm.invalid/schemas/manifest-record.schema.json",
  "title": "MCM corpus manifest record",
  "type": "object",
  "required": [
    "record_version",
    "document_id",
    "content_id",
    "relative_path",
    "file_name",
    "file_extension",
    "file_size_bytes",
    "modified_time_ns",
    "sha256",
    "year",
    "problem_type",
    "type_signals",
    "classification_status",
    "document_role",
    "award_status",
    "eligible_paper",
    "paper_id",
    "pdfinfo_status",
    "text_probe_class"
  ],
  "properties": {
    "record_version": {"const": 1},
    "document_id": {"type": "string", "pattern": "^D-[a-f0-9]{12}$"},
    "content_id": {"type": "string", "pattern": "^C-[a-f0-9]{12}$"},
    "paper_id": {"type": ["string", "null"]},
    "relative_path": {"type": "string", "minLength": 1},
    "file_name": {"type": "string", "minLength": 1},
    "file_extension": {"type": "string"},
    "file_size_bytes": {"type": "integer", "minimum": 0},
    "modified_time_ns": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "year": {"type": ["string", "null"], "pattern": "^(?:19|20)\\d{2}$"},
    "problem_type": {"type": ["string", "null"], "enum": ["A", "B", "C", "D", "E", "F", null]},
    "type_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "source", "value", "part_index"],
        "properties": {
          "type": {"enum": ["A", "B", "C", "D", "E", "F"]},
          "source": {"enum": ["parent-folder", "filename-prefix", "filename-pattern"]},
          "value": {"type": "string"},
          "part_index": {"type": "string", "pattern": "^\\d+$"}
        },
        "additionalProperties": false
      }
    },
    "classification_status": {"enum": ["classified", "conflict", "not-classified"]},
    "document_role": {
      "enum": [
        "award-paper-primary",
        "award-paper-finalist",
        "problem-statement",
        "results-document",
        "judging-or-triage-guide",
        "problem-dataset",
        "supplemental-code",
        "supplemental-document",
        "other-award-paper",
        "out-of-scope-problem-type",
        "unknown-quarantine"
      ]
    },
    "award_status": {"type": ["string", "null"]},
    "award_evidence": {"type": ["string", "null"]},
    "eligible_paper": {"type": "boolean"},
    "eligibility_reason": {"type": ["string", "null"]},
    "exclusion_reason": {"type": ["string", "null"]},
    "page_count": {"type": ["integer", "null"], "minimum": 0},
    "pdfinfo_status": {"enum": ["ok", "error", "not-run", "not-applicable"]},
    "pdfinfo_error": {"type": ["string", "null"]},
    "text_probe_class": {"enum": ["text-rich", "text-sparse", "no-text", "probe-error", "not-run", "not-applicable"]},
    "text_probe_chars": {"type": ["integer", "null"], "minimum": 0},
    "text_probe_words": {"type": ["integer", "null"], "minimum": 0},
    "text_probe_pages": {"type": ["integer", "null"], "minimum": 1},
    "text_probe_error": {"type": ["string", "null"]}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {"properties": {"eligible_paper": {"const": true}}},
      "then": {
        "properties": {
          "paper_id": {"type": "string"},
          "problem_type": {"enum": ["A", "B", "C", "D", "E", "F"]},
          "document_role": {"enum": ["award-paper-primary", "award-paper-finalist"]}
        }
      }
    }
  ]
}
