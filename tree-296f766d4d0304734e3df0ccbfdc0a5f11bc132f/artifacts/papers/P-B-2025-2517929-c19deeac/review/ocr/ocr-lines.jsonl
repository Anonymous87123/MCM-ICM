nfidence":0.876606,"text":"gotiation, or welfare policies."},{"box":[[292.0,1975.0],[1440.0,1975.0],[1440.0,2004.0],[292.0,2004.0]],"confidence":0.929182,"text":"In addition, unlike Juneau, which spends on infrastructure, road construction, and eco"},{"box":[[293.0,2019.0],[1411.0,2019.0],[1411.0,2052.0],[293.0,2052.0]],"confidence":0.937233,"text":"logical projects, cities with fewer tourists should focus spending on external promo-"},{"box":[[294.0,2066.0],[1262.0,2066.0],[1262.0,2096.0],[294.0,2096.0]],"confidence":0.912589,"text":"tion and the development of tourism projects to boost economic income."},{"box":[[1459.0,2184.0],[1614.0,2184.0],[1614.0,2211.0],[1459.0,2211.0]],"confidence":0.854623,"text":"关注数学模型"},{"box":[[1458.0,2242.0],[1615.0,2242.0],[1615.0,2269.0],[1458.0,2269.0]],"confidence":0.808579,"text":"获取更多资讯"}],"page_index":22,"rendered_file":"tmp/q160-extraction-v1/P-B-2025-2517929-c19deeac/rendered/page-0022.png"}
