      "section": "3.1 Network Construction",
      "family": "network-analysis",
      "purpose": "Represent one match as an undirected weighted passing graph and score it with four structural indices",
      "base_or_modification": "base",
      "summary": "Nodes are all players who appear, including substitutes, so the order can exceed 11. An edge exists iff a pass is recorded; its weight is the pass count regardless of direction, so the adjacency matrix is symmetric. Four indices follow: largest adjacency eigenvalue as network strength, algebraic connectivity of the Laplacian, mean clustering coefficient, and mean shortest-path length with topological distance 1/Aij computed by Dijkstra.",
      "algorithm": {
        "status": "implemented",
        "steps": [
          "Aggregate passes within a match into an undirected weighted adjacency matrix",
          "Compute the largest eigenvalue of A",
          "Form the Laplacian S-A and take its second-smallest eigenvalue",
          "Average the local clustering coefficients",
          "Run Dijkstra on distances 1/Aij and average"
        ],
        "software": [
          "not stated"
        ],
        "convergence_criteria": "Exact linear-algebra and shortest-path computation"
      },
      "assumptions": [
        "Direction of a pass carries no information",
        "Records are unbiased even if not exact"
      ],
      "computational_cost": "Low: one eigen-decomposition and one all-pairs shortest path per match",
      "conditions": {
        "initial": {
          "status": "not-applicable",
          "details": [
            "Not a dynamic initial-value model"
          ]
        },
        "boundary": {
