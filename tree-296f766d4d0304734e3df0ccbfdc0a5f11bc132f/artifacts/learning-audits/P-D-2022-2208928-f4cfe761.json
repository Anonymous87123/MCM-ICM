    "main_argument_chains": [
      {
        "claim": "A data-and-analytics system can be placed on a maturity level by mixing an objective weighting with a subjective one.",
        "support_steps": [
          "Twelve indicators reduce the three components to numbers scaled toward one.",
          "Entropy weights take four fifths because the indicators are measurable.",
          "The fuzzy score takes the remaining fifth."
        ],
        "decision_consequence": "The final score falls into one of five named bands.",
        "source_pages": [
          4,
          7,
          8
        ]
      },
      {
        "claim": "The same model serves firms of different size once component weights are read off demand curves.",
        "support_steps": [
          "Economies of scale suggest that size changes the cost of a component.",
          "Two quadratics fitted to berth counts cross at one point.",
          "The demands are rescaled and renormalized into weights."
        ],
        "decision_consequence": "Equal weights are defended only at that one scale, and other industries need extra steps.",
        "source_pages": [
          15,
          16,
          17
        ]
      }
    ]
  },
