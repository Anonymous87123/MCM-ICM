    "main_argument_chains": [
      {
        "claim": "A borrowed question and a cosine division give the carbon total. Equation 3 prints 1 minus a where equation 2 prints alpha. The age formula on page 8 is missing a glyph. The ideal run, on 17.98 times 10 to the 4 hectares with weights 0.7 and 0.3, states 8.62 times 10 to the 9 kilograms. The Beijing case, on 1.79 times 10 to the 4 hectares with weights 0.65 and 0.35, states 1.08 times 10 to the 10 kilograms and a score of 4.0677. Program three is 0.06 percent and 30 years. A ten-year lengthening asks for 0.09 percent, which is on neither printed list. The newspaper puts 4.83 times 10 to the 9 kilograms on 14 hectares and calls that about 1/5 times the world average.",
        "support_steps": [
          "Print 1 minus a on the living-area line",
          "Leave the age glyph and the capacity exponent unparsed",
          "State 8.62e9 on one Beijing area and 1.08e10 on another",
          "Read 0.06 percent and 30 years off shifted program rows",
          "Ask for 0.09 percent, and print 4.83e9 kilograms on 14 hectares"
        ],
        "decision_consequence": "Cut Beijing at 0.06 percent every 30 years, and do not treat the 8.62e9 kilogram run, the 0.09 percent rate, or the 14-hectare article as that plan.",
        "source_pages": [
          7,
          8,
          14,
          16,
          19
        ]
      }
    ],
