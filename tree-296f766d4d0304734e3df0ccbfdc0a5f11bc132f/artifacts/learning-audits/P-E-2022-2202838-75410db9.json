    "main_argument_chains": [
      {
        "claim": "A logical growth and a sum of trees, plants, and soil give the carbon total. After 100 years the summary states 4.264 billion tons, of which the forest is 2.724 and the products are 1.540. The optimal shares are 58.95, 11.20, 11.41, and 18.37 percent, beside a sentence that each share is less than 10 percent. Adding 10 years changes the shares to 55.87, 10.23, 10.11, and 23.71. The newspaper uses the second set. Commercial logging has been suspended since 2015, and the plan still cuts.",
        "support_steps": [
          "Call the growth logical and leave displays 8 and 9 empty",
          "Add the three pools and leave the IPCC defaults blank",
          "Score value against cost and paint the preferred cell blue",
          "Print four shares that all exceed the stated 10 percent cap",
          "Keep the 2015 suspension and the recommended cut in one paragraph"
        ],
        "decision_consequence": "Keep a cut in the plan after the 2015 suspension, and do not use the summary shares and the newspaper shares as one plan.",
        "source_pages": [
          8,
          15,
          19,
          20,
          23
        ]
      }
