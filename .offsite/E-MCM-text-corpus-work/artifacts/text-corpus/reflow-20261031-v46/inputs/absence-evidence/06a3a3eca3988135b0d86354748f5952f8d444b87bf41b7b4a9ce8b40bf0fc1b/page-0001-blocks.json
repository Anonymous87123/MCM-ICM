    ],
    "section_id": "s0003",
    "source_line_ids": [
      "p0001-n0006-l0001",
      "p0001-n0006-l0002",
      "p0001-n0006-l0003",
      "p0001-n0006-l0004",
      "p0001-n0006-l0005",
      "p0001-n0006-l0006"
    ],
    "source_pages": [
      1
    ],
    "text": "In 2018, the number of people in the Louvre was 10.8 million, creating a new high. At the same time, in the event of an emergency, such a large number of tourists will increase the difficulty of evacuation and raise the risk. Therefore, our goal is to design the Louvre's emergency evacuation plan to evacuate visitors from the museum and estimate the evacuation time, while also allowing emergency personnel to enter the building as quickly as possible, as well as considering other factors and potential threats."
  },
  {
    "block_id": "b000011",
    "issues": [],
    "kind": "prose",
    "repairs": [
      {
        "left": "p0001-n0007-l0000",
        "operation": "line_wrap_to_space",
        "right": "p0001-n0007-l0001"
      },
      {
