    "source_line_ids": [
      "p0001-n0010-l0000"
    ],
    "source_pages": [
      1
    ],
    "text": "Networks of Musicians"
  },
  {
    "block_id": "b000012",
    "issues": [],
    "kind": "heading",
    "repairs": [],
    "section_id": "s0003",
    "source_line_ids": [
