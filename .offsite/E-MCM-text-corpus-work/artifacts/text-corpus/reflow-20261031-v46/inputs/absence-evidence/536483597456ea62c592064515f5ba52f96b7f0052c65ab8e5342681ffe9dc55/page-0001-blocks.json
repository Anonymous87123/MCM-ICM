    ],
    "text": "(Your team's summary should be included as the first page of your electronic submission.) Type a summary of your results on this page. Do not include the name of your school, advisor, or team members on this page."
  },
  {
    "block_id": "b000011",
    "issues": [],
    "kind": "heading",
