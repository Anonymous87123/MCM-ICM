        "operation": "line_wrap_to_space",
        "right": "p0001-n0011-l0004"
      },
      {
        "left": "p0001-n0011-l0004",
        "operation": "line_wrap_to_space",
        "right": "p0001-n0011-l0005"
      },
      {
        "left": "p0001-n0011-l0005",
        "operation": "line_wrap_to_space",
        "right": "p0001-n0011-l0006"
      },
      {
        "left": "p0001-n0011-l0006",
        "operation": "line_wrap_to_space",
        "right": "p0001-n0011-l0007"
      },
      {
        "left": "p0001-n0011-l0007",
