    ],
    "section_id": "s0003",
    "source_line_ids": [
      "p0001-n0020-l0000",
      "p0001-n0020-l0001",
      "p0001-n0020-l0002",
      "p0001-n0020-l0003",
      "p0001-n0020-l0004"
    ],
    "source_pages": [
      1
    ],
    "text": "The third model utilizes AHP to choose the best alternatives in terms of overall performance based on \ufb01ve factors. The SpaDE ODR system is evaluated to be the most favorable one.Our sensitivity analysis demonstrates that our \ufb01rst debris removal model is robust to parameters changes. The AHP model is sensitive to the relative weights value of the \ufb01ve factors."
  },
