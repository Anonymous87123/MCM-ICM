    "source_pages": [
      1
    ],
    "text": "\u2018Rapid Bushfire Response\u2019 UAV System"
  },
  {
    "block_id": "b000011",
    "issues": [],
    "kind": "title",
    "repairs": [],
    "section_id": "s0002",
    "source_line_ids": [
