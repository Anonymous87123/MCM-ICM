    ],
    "source_pages": [
      1
    ],
    "text": "Predicting the number of Olympic medals each country will win is crucial for various stakeholders. We therefore developed an Olympic medal model based on the dataset of past Olympic Games."
  },
  {
    "block_id": "b000011",
    "issues": [
      "hyphen_join_review"
    ],
    "kind": "prose",
    "repairs": [
      {
