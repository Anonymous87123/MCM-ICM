        "right": "p0001-n0038-l0000"
      },
      {
        "left": "p0001-n0038-l0000",
        "operation": "line_wrap_to_space",
        "right": "p0001-n0039-l0000"
      }
    ],
    "section_id": "s0002",
    "source_line_ids": [
      "p0001-n0033-l0000",
      "p0001-n0034-l0000",
      "p0001-n0035-l0000",
      "p0001-n0036-l0000",
