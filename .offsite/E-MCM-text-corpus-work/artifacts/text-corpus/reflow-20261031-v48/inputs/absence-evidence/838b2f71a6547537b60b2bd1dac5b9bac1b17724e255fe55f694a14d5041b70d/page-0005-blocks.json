      "p0005-n0019-l0000"
    ],
    "source_pages": [
      5
    ],
    "text": "In order to ensure that our models are remain valid given various potential constraints, we make a number of assumptions. Before going into detail about our approach, we list those assumptions here."
  },
  {
    "block_id": "b000032",
    "issues": [],
    "kind": "prose",
    "repairs": [
      {
        "left": "p0005-n0020-l0000",
        "operation": "line_wrap_to_space",
        "right": "p0005-n0020-l0001"
      }
    ],
