      },
      {
        "left": "p0001-n0016-l0001",
        "operation": "line_wrap_to_space",
        "right": "p0001-n0016-l0002"
      }
    ],
    "section_id": "s0004",
    "source_line_ids": [
      "p0001-n0016-l0000",
      "p0001-n0016-l0001",
      "p0001-n0016-l0002"
    ],
    "source_pages": [
      1
    ],
    "text": "In conclusion, our model has the strength of robustness and comprehensiveness. This provides scientific guidance and support for the regulation of the Great Lakes in the future."
  },
