    ],
    "source_pages": [
      1
    ],
    "text": "\u5fae\u4fe1\u53f7\uff1aMATHmodels"
  },
  {
    "block_id": "b000015",
    "issues": [],
    "kind": "prose",
    "repairs": [],
    "section_id": "s0003",
    "source_line_ids": [
      "p0001-n0011-l0005"
    ],
    "source_pages": [
      1
    ],
    "text": "establishes the optimal water level for the Great Lakes on a monthly basis."
  },
  {
    "block_id": "b000016",
    "issues": [
      "hyphen_join_review"
    ],
    "kind": "prose",
