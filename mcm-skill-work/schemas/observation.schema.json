{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mcm.invalid/schemas/observation.schema.json",
  "title": "Atomic paper observation",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "paper_id",
    "problem_type",
    "year",
    "page",
    "section",
    "evidence_class",
    "dimension",
    "source_basis",
    "interpretation",
    "applicability",
    "counterevidence",
    "confidence",
    "candidate_rule_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "observation_id": {"type": "string", "pattern": "^O-[A-F]-[A-Za-z0-9-]+$"},
    "paper_id": {"type": "string", "pattern": "^P-[A-F]-"},
    "problem_type": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "year": {"type": "string", "pattern": "^(?:19|20)\\d{2}$"},
    "page": {"type": "integer", "minimum": 1},
    "section": {"type": ["string", "null"]},
    "evidence_class": {"enum": ["O", "P", "I", "E", "J", "C"]},
    "dimension": {"enum": ["language", "modeling", "logic", "visualization", "verification", "data", "assumption", "result", "weakness", "other"]},
    "source_basis": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "applicability": {"type": "array", "items": {"type": "string"}},
    "counterevidence": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "candidate_rule_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
