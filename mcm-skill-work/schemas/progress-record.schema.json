{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mcm.invalid/schemas/progress-record.schema.json",
  "title": "Paper study progress record",
  "type": "object",
  "required": [
    "progress_version",
    "queue_position",
    "paper_id",
    "problem_type",
    "year",
    "source_relative_path",
    "status",
    "extraction_status",
    "paper_card_status",
    "branch_update_status",
    "validation_status"
  ],
  "properties": {
    "progress_version": {"const": 1},
    "queue_position": {"type": "integer", "minimum": 1},
    "paper_id": {"type": "string", "pattern": "^P-[A-F]-"},
    "problem_type": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "year": {"type": "string", "pattern": "^(?:19|20)\\d{2}$"},
    "source_relative_path": {"type": "string", "minLength": 1},
    "status": {"enum": ["discovered", "scope-verified", "integrity-checked", "text-extracted", "layout-inspected", "section-mapped", "deep-read", "paper-card-complete", "type-branch-updated", "post-update-validated", "closed", "needs-ocr", "corrupt", "classification-conflict", "duplicate-candidate", "missing-pages-suspected", "manual-equation-review", "manual-figure-review"]},
    "extraction_status": {"enum": ["pending", "text-extracted", "partial-text-review", "needs-ocr", "validated"]},
    "paper_card_status": {"enum": ["pending", "draft", "source-checked", "validated"]},
    "branch_update_status": {"enum": ["pending", "updated", "validated"]},
    "validation_status": {"enum": ["pending", "pass", "fail"]}
  },
  "additionalProperties": false
}
