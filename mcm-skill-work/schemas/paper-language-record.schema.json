{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mcm.invalid/schemas/paper-language-record.schema.json",
  "title": "Protocol v3 per-paper language record with quantitative chapter layouts",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "problem_type",
    "year",
    "source_sha256",
    "available_chapters",
    "units",
    "chapter_layouts",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "paper_id": {"type": "string", "pattern": "^P-[A-F]-"},
    "problem_type": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "year": {"type": "string", "pattern": "^(?:19|20)\\d{2}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "available_chapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/languageUnit"}
    },
    "chapter_layouts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/chapterLayout"}
    },
    "review_status": {"enum": ["draft", "source-checked", "validated"]}
  },
  "additionalProperties": false,
  "$defs": {
    "chapterLayout": {
      "type": "object",
      "required": [
        "chapter", "page_start", "page_end", "page_fraction", "word_count",
        "sentence_count", "paragraph_count", "sentence_words",
        "paragraph_functions", "rhetorical_proportions", "content_counts",
        "move_types", "counting_method", "ambiguities"
      ],
      "properties": {
        "chapter": {"type": "string", "minLength": 1},
        "page_start": {"type": "integer", "minimum": 1},
        "page_end": {"type": "integer", "minimum": 1},
        "page_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "word_count": {"type": "integer", "minimum": 1},
        "sentence_count": {"type": "integer", "minimum": 1},
        "paragraph_count": {"type": "integer", "minimum": 1},
        "sentence_words": {
          "type": "object",
          "required": ["minimum", "median", "maximum"],
          "properties": {
            "minimum": {"type": "number", "exclusiveMinimum": 0},
            "median": {"type": "number", "exclusiveMinimum": 0},
            "maximum": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        },
        "paragraph_functions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rhetorical_proportions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "content_counts": {
          "type": "object",
          "required": ["equations", "figures", "tables", "citations", "quantitative_results"],
          "properties": {
            "equations": {"type": "integer", "minimum": 0},
            "figures": {"type": "integer", "minimum": 0},
            "tables": {"type": "integer", "minimum": 0},
            "citations": {"type": "integer", "minimum": 0},
            "quantitative_results": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "move_types": {
          "type": "object",
          "required": ["opening", "transition", "closing"],
          "properties": {
            "opening": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "transition": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "closing": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "counting_method": {"type": "string", "minLength": 1},
        "ambiguities": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "languageUnit": {
      "type": "object",
      "required": [
        "language_unit_id",
        "page",
        "section",
        "chapter",
        "granularity",
        "source_excerpt",
        "function",
        "rhetorical_move",
        "information_order",
        "features",
        "reusable_pattern",
        "reusable_elements",
        "prohibited_generalizations",
        "candidate_pattern_ids"
      ],
      "properties": {
        "language_unit_id": {"type": "string", "pattern": "^LU-[A-F]-"},
        "page": {"type": "integer", "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "chapter": {"type": "string", "minLength": 1},
        "granularity": {"enum": ["word", "phrase", "sentence", "paragraph", "section"]},
        "source_excerpt": {"type": "string", "minLength": 1, "maxLength": 500},
        "function": {"type": "string", "minLength": 1},
        "rhetorical_move": {"type": "string", "minLength": 1},
        "information_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "features": {"type": "object"},
        "reusable_pattern": {"type": "string", "minLength": 1},
        "reusable_elements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prohibited_generalizations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "candidate_pattern_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
