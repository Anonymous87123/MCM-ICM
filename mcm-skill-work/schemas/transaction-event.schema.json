{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mcm.invalid/schemas/transaction-event.schema.json",
  "title": "Append-only paper transaction event",
  "type": "object",
  "required": [
    "event_id", "sequence", "timestamp_utc", "event_type", "paper_id", "before", "after",
    "changed_fields", "artifact_diffs", "type_branch_diff", "validation_results",
    "unresolved_added", "unresolved_resolved", "history_completeness",
    "previous_event_hash", "event_hash"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^TX-[0-9]{6}-[a-f0-9]{12}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "event_type": {"enum": ["migration-baseline", "paper-closed", "paper-corrected", "schema-migrated"]},
    "paper_id": {"type": "string", "pattern": "^P-[A-F]-"},
    "before": {"type": "object"},
    "after": {"type": "object"},
    "changed_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifact_diffs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "type_branch_diff": {"type": "object"},
    "validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["validator", "status"],
        "properties": {
          "validator": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]},
          "details": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "unresolved_added": {"type": "array", "items": {"type": "string"}},
    "unresolved_resolved": {"type": "array", "items": {"type": "string"}},
    "history_completeness": {"enum": ["native", "baseline-only"]},
    "previous_event_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
