    "text": "Survival or Death: Moving Fish and Fishery"
  },
  {
    "block_id": "b000009",
    "issues": [],
    "kind": "prose",
    "repairs": [
      {
        "left": "p0001-n0010-l0002",
        "operation": "line_wrap_to_space",
