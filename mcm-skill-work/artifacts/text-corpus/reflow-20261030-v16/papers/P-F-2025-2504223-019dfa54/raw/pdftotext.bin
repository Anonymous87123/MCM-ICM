                             Table 2: Survival EM Algorithm
    Initialize:
    t←0
    θt ← θ0
    converged ← false
    While not converged and t < maxIter do:
    // E-Step: Compute Expectation of the complete-data log-likelihood
    Q(θ|θ t ) ← 0
    For i = 1 to n do:
       If δi = 1 then: // Complete data
          Q(θ|θ t ) ← Q(θ|θ t ) + log f (xi |θ)
       Else: // Censored data
          Q(θ|θ t ) ← Q(θ|θ t ) + log S(xi |θ) // Contribution from censored observa-
    tion
       End If
    End For
    // M-Step: Maximize Q(θ|θ t ) with respect to θ
                  t
    Solve ∂Q(θ|θ
              ∂θ
                    )
                      = 0 for θ to get θ t+1
    // Check Convergence
    If kθ t+1 − θ t k < ε or |L(θ t+1 ) − L(θ t )| < ε then:
       converged ← true
    End If
    t←t+1
    θ t ← θ t+1
    End While
    Return θ t

