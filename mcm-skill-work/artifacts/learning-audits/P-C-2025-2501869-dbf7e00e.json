      {
        "claim": "The hurdle fits the medal powers and the tobit fits the countries with few medals.",
        "support_steps": [
          "Poisson fails on overdispersion.",
          "The zero-inflated model fails because the structural zero is absent.",
          "The hurdle covers more countries, and the tobit is more exact at zero."
        ],
        "decision_consequence": "Both models are kept, each for the country type it fits.",
        "source_pages": [
          7,
          11
        ]
      },
      {
        "claim": "Three countries can win a first medal, and the rest of the field is not named.",
        "support_steps": [
          "The first stage is a logit.",
          "The count is a truncated expectation.",
          "Angola, Bangladesh, and Cambodia are the three probabilities printed."
        ],
        "decision_consequence": "The breakthrough list is three countries.",
        "source_pages": [
          9,
          13
        ]
      },
      {
        "claim": "A coach adds medals only after the plain regression is abandoned.",
        "support_steps": [
          "The score is smoothed so the detector does not fire on noise.",
          "The coach is fit on the score first.",
          "The two-stage fit ranks above the plain one, and both are said to explain."
        ],
        "decision_consequence": "The investment advice is a range of one to two medals, not a point.",
        "source_pages": [
          19,
