    "main_argument_chains": [
      {
        "claim": "A data-and-analytics system can be placed on a maturity band by mapping sixteen indicators and weighting them in two layers.",
        "support_steps": [
          "Sixteen sub-indicators reduce people, technology and process to ratios or self-scores.",
          "Three maps remove the conflict between indicator directions.",
          "The analytic hierarchy weights combine the scores into one number read on five bands."
        ],
        "decision_consequence": "The score 82.734 falls in the Optimizing band.",
        "source_pages": [
          6,
          9,
          20
        ]
      },
      {
        "claim": "Customers adopt the metric only when its benefit exceeds its cost, and a lower cost raises the benefit faster.",
        "support_steps": [
          "Adopters earn the benefit minus the cost and everyone else earns nothing.",
          "The replicator equation makes the share grow exactly when the benefit wins.",
          "The plotted curves climb fastest at high benefit and low cost."
        ],
        "decision_consequence": "The firm is told to clear the cost first and then cut it.",
        "source_pages": [
          21
        ]
      }
    ]
  },
