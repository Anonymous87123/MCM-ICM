  "organization_logic": {
    "positive_artifacts_status": "complete",
    "weakness_substitution_allowed": false,
    "global_organization_chain": [
      "Turn rising attention into a fork with two outcomes before naming any method.",
      "Concede which indicators have no formula before writing the ones that do.",
      "Route every indicator to its map by direction before any weighting.",
      "Pose the priority question before giving advice, and derive the balance in words before the formula.",
      "Bound each method by the job it cannot do in the same section that credits it."
    ],
    "section_progressions": [
      {
        "chapter": "abstract",
        "positive_pattern": "a concept whose attention is rising",
        "moves": [
          "input: a concept whose attention is rising",
          "rhetorical job: raise it to a decisive fork, then report each requirement in three beats",
          "analytical job: state the score, the ranking, the protocols and the adoption result",
          "output: the four-requirement plan",
          "handoff: the background takes up why the data stays hard to use"
        ]
      },
      {
        "chapter": "introduction",
        "positive_pattern": "data that grows in importance and in difficulty together",
        "moves": [
          "input: data that grows in importance and in difficulty together",
          "rhetorical job: grant the importance, name the difficulty, then give each department its demand",
          "analytical job: commit the model to three components and their links",
          "output: the motive and the plan",
          "handoff: the assumption list states what the plan rests on"
        ]
      },
      {
        "chapter": "assumptions",
        "positive_pattern": "the simplifications the queue and the scoring need",
        "moves": [
          "input: the simplifications the queue and the scoring need",
          "rhetorical job: open the list in one sentence and state the memoryless property in words",
          "analytical job: fix comparability, equal rates, memorylessness and identical customers",
          "output: five bare assumptions",
          "handoff: the notation table names the symbols the assumptions allow"
        ]
      },
      {
        "chapter": "notation",
        "positive_pattern": "the symbols the formulas will use",
        "moves": [
          "input: the symbols the formulas will use",
          "rhetorical job: hand them to a two-column table",
          "analytical job: collect every symbol",
          "output: the symbol table",
          "handoff: the indicator section uses the symbols"
        ]
      },
      {
        "chapter": "model-establishment",
        "positive_pattern": "the factors behind maturity",
        "moves": [
          "input: the factors behind maturity",
          "rhetorical job: concede the missing formulas, then route each indicator to a map by its direction",
          "analytical job: select the indicators, map them, weight them and place the score",
          "output: the maturity in [0, 100] on five bands",
          "handoff: the improvement section asks which indicator to raise first"
        ]
      },
      {
        "chapter": "model-improvement",
        "positive_pattern": "the score and the question of priority",
        "moves": [
          "input: the score and the question of priority",
          "rhetorical job: name the causal link, rank the nodes, then answer each stakeholder",
          "analytical job: order the improvements and state the hiring conditions",
          "output: the advice keyed to indicator scores",
          "handoff: the protocol section keeps its rules downstream of two models"
        ]
      },
      {
        "chapter": "algorithm",
        "positive_pattern": "the transmission process and the cascade",
        "moves": [
          "input: the transmission process and the cascade",
          "rhetorical job: translate the process into a queue by explicit roles, then equate the flows",
          "analytical job: derive the expected volume and grade the effectiveness",
          "output: the five protocol rules and the four bands",
          "handoff: the results section spends the maturity model on random data"
        ]
      },
