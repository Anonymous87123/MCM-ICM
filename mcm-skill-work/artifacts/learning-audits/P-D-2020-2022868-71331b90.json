    "main_argument_chains": [
      {
        "claim": "Strong pairs and triples do not predict shots.",
        "support_steps": [
          "define three strengths",
          "regress on 50-pass and 100-pass windows",
          "compare with a flat guess"
        ],
        "decision_consequence": "Without this negative result the paper would have stayed with motifs and never built the style model.",
