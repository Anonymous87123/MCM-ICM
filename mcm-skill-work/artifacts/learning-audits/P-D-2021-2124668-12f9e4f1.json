    "main_argument_chains": [
      {
        "claim": "Established genre is not a sonic category, so groups cut from sound alone describe the music better than the labels do.",
        "support_steps": [
          "A neural network cannot predict genre from the sonic variables unless the labels are cut to four.",
          "K-means on the same variables yields four groups that the network recovers at twice the chance rate.",
          "The adjusted Rand index between the two partitions is only 0.161."
        ],
        "decision_consequence": "The revolutions are read off the sonic centroids, not off the established labels.",
        "source_pages": [
          7,
          8,
          9
        ]
      },
      {
        "claim": "The biggest moves of a popularity-weighted sonic centroid are the musical revolutions, and the artists behind them can be ranked.",
        "support_steps": [
          "The centroid jumps past a fixed threshold in a handful of decades.",
          "Eligible artists are those whose career began in that decade.",
          "They are ordered by direct centrality times similarity to the later centroid."
        ],
        "decision_consequence": "The dated breaks are compared with the journalism, and the unmatched ones are argued to be real but invisible to genre history.",
        "source_pages": [
          13,
          15,
          17
        ]
      }
    ]
  },
