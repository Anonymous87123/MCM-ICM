    "main_argument_chains": [
      {
        "claim": "Influence cools, fast then slow, after holding steady.",
        "support_steps": [
          "argue timeliness",
          "write the proportional rate",
          "integrate",
          "set the floor to zero",
          "check against one band's decade counts"
        ],
        "decision_consequence": "A constant influence would have ranked early artists forever and hidden the first-decade peak.",
        "source_pages": [
          4,
          6,
          7
        ]
      },
      {
        "claim": "Cosine similarity in a factor space recovers genre structure and exposes contagious traits.",
        "support_steps": [
          "reduce to four factors",
          "prefer cosine for its fixed range",
          "compare within and between",
          "remove each feature in turn"
        ],
        "decision_consequence": "Raw Euclidean distance would have needed scaling and would have double-counted overlapping features.",
        "source_pages": [
          8,
          9,
          10
        ]
      },
      {
        "claim": "Revolutions are drops in year-to-year resemblance, and they have names.",
        "support_steps": [
          "compare each year with the next",
          "mark the sharp drops",
          "name the artists inside one window"
        ],
        "decision_consequence": "Without the year-to-year comparison the revolutionary decades would be impressions.",
        "source_pages": [
          15,
          16
        ]
      }
    ]
