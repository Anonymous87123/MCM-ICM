    "main_argument_chains": [
      {
        "claim": "Ordinary PageRank flatters old nodes, and local standardization fixes it.",
        "support_steps": [
          "show the directed distances near one",
          "list three failures",
          "standardize within a window of contemporaries",
          "check the 1980s top hundred"
        ],
        "decision_consequence": "Without rescaling every late artist would score near zero and no cross-decade comparison would exist.",
        "source_pages": [
          6,
          7,
          8
        ]
      },
      {
        "claim": "Similarity can be learned from the network and then put back into the ranking.",
        "support_steps": [
          "label pairs by geodesic distance",
          "minimize squared error",
          "replace indegree with the result",
          "compare the two top-hundred lists"
        ],
        "decision_consequence": "Without the learned weights, similarity would treat every feature as equal and the updated ranking would not exist.",
        "source_pages": [
          8,
          9,
          10,
          11
        ]
      },
      {
        "claim": "Revolutions have an inner and an outer source, and only two of three tests are usable.",
