  "main_argument_chains": [
   {
    "claim": "a state's fragility can be scored as a weighted sum of stress, status and response indicators",
    "support_steps": [
     "group the indicators into three layers",
     "weight each by its entropy",
     "sum the weighted values"
    ],
    "decision_consequence": "read a higher score as a more fragile state",
    "source_pages": [
     4,
     8
    ]
   },
   {
    "claim": "the line between vulnerable and fragile can date when a country turns",
    "support_steps": [
     "cut the scores into three levels",
     "take the upper boundary as the tipping point",
     "project the indicators until the score crosses it"
    ],
    "decision_consequence": "treat the crossing year as the deadline for intervention",
    "source_pages": [
     9,
     14
    ]
   }
  ]
