    "main_argument_chains": [
      {
        "claim": "The server's winning probability sits above the receiver's, and the gap is the natural advantage.",
        "support_steps": [
          "The two cases get different inputs.",
          "The network remembers the previous game.",
          "The two fit numbers are printed."
        ],
        "decision_consequence": "Serving is treated as an advantage the momentum has to live with.",
        "source_pages": [
          5,
          8
        ]
      },
      {
        "claim": "A player's success is not random but related to momentum.",
        "support_steps": [
          "Four events are given fixed scores.",
          "Five features are reduced to three.",
          "Both rank correlations are printed."
        ],
        "decision_consequence": "Randomness is refused on two numbers, not on one.",
        "source_pages": [
          10,
          15
        ]
      },
      {
        "claim": "The accumulated momentum can be continued, and the continuation can be coached.",
        "support_steps": [
          "The series is said to be cyclical.",
          "The orders are fixed at 4, 1, and 4.",
          "The advice covers the opponent's streak as well as the player's."
        ],
        "decision_consequence": "The ten-game lead is offered as a possibility, not a certainty.",
        "source_pages": [
          16,
          21
        ]
      }
