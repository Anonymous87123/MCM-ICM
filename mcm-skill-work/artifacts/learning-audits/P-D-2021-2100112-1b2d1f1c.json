    "main_argument_chains": [
      {
        "claim": "Influence depends on who the followers are, not only on how many.",
        "support_steps": [
          "count out-degree",
          "reweight by genre and year gap",
          "spread weight to neighbors",
          "show one artist who ranks higher with fewer followers"
        ],
        "decision_consequence": "Plain degree would have ranked Marvin Gaye above Howlin' Wolf and missed the point of the score.",
        "source_pages": [
          5,
          6,
          7
        ]
      },
      {
        "claim": "Same-genre artists are more similar, and no single trait is more contagious.",
        "support_steps": [
          "reduce to seven components",
          "rank test",
          "build the similarity graph",
          "test the trait vectors"
        ],
        "decision_consequence": "A t-test would have been invalid, and skipping the second test would have left contagion unanswered.",
        "source_pages": [
          7,
          8,
          9,
          13,
          14,
          15
        ]
      },
      {
        "claim": "The musical break of the 1950s is visible in four characteristics and in named artists.",
        "support_steps": [
          "define a revolution from genre counts",
          "date breaks by dynamic programming",
          "match four characteristics",
          "read the core of the 1950s graph"
        ],
        "decision_consequence": "Without the break dates the dynamic-influencer list would have no reason to start at 1956.",
        "source_pages": [
          16,
          17,
          18,
          19,
          20
        ]
      }
    ]
  },
