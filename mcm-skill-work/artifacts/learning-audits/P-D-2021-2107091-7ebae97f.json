    "main_argument_chains": [
      {
        "claim": "The rarer direction of influence deserves more weight.",
        "support_steps": [
          "note juniors are usually shaped by predecessors",
          "treat the reverse as evidence of strength",
          "flag cross-genre edges the same way",
          "combine and normalize by the maximum gap"
        ],
        "decision_consequence": "Equal weights would have buried the rare, informative edges under the common ones.",
        "source_pages": [
          5,
          6
        ]
      },
      {
        "claim": "The influence network is scale-free.",
        "support_steps": [
          "compute the scores",
          "plot the frequency",
          "fit a power law by maximum likelihood",
          "report the interval and the fit"
        ],
        "decision_consequence": "Without the fit the Pareto remark would be a slogan.",
        "source_pages": [
          7,
          8
        ]
      },
      {
        "claim": "Reported influence is real, and it respects time order.",
        "support_steps": [
          "drop later releases",
          "compare inside a window",
          "set a threshold",
          "sum by decade"
        ],
        "decision_consequence": "A pooled comparison would have let future work explain the past.",
        "source_pages": [
          16,
          17,
          18,
          20
        ]
      }
    ]
  },
