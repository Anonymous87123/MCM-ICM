  "paragraph_chains": [
    {
      "chapter": "abstract",
      "visual_paragraph_count": 8,
      "coverage_status": "complete",
      "gaps": [],
      "paragraphs": [
        {
          "paragraph_index": 1,
          "dominant_move": "Accuse the plan of chasing profit",
          "language_unit_ids": [
            "LU-E-2022-2216618-001"
          ]
        },
        {
          "paragraph_index": 2,
          "dominant_move": "Define the removal two ways",
          "language_unit_ids": [
            "LU-E-2022-2216618-002"
          ]
        },
        {
          "paragraph_index": 3,
          "dominant_move": "Call one model sophisticated and only money",
          "language_unit_ids": [
            "LU-E-2022-2216618-003"
          ]
        },
        {
          "paragraph_index": 4,
          "dominant_move": "Name the index by three pieces",
          "language_unit_ids": [
            "LU-E-2022-2216618-004"
          ]
        },
        {
          "paragraph_index": 5,
          "dominant_move": "Split the world and give each a weight",
          "language_unit_ids": [
            "LU-E-2022-2216618-005"
          ]
        },
        {
          "paragraph_index": 6,
          "dominant_move": "Say the surprise is no cut",
          "language_unit_ids": [
            "LU-E-2022-2216618-006"
          ]
        },
        {
          "paragraph_index": 7,
          "dominant_move": "Say the other forest must be cut",
          "language_unit_ids": [
            "LU-E-2022-2216618-007"
          ]
        },
        {
          "paragraph_index": 8,
          "dominant_move": "Promise a newspaper",
          "language_unit_ids": [
            "LU-E-2022-2216618-008"
          ]
        }
      ]
    },
    {
      "chapter": "introduction",
      "visual_paragraph_count": 4,
      "coverage_status": "complete",
      "gaps": [],
      "paragraphs": [
        {
          "paragraph_index": 1,
          "dominant_move": "Open on the warming and the warm years",
          "language_unit_ids": [
            "LU-E-2022-2216618-009"
          ]
        },
        {
          "paragraph_index": 2,
          "dominant_move": "Give the forest its area and its share",
          "language_unit_ids": [
            "LU-E-2022-2216618-010"
          ]
        },
        {
          "paragraph_index": 3,
          "dominant_move": "Give the panel a tonnage and a year",
          "language_unit_ids": [
            "LU-E-2022-2216618-011"
          ]
        },
        {
          "paragraph_index": 4,
          "dominant_move": "Say the short term wants no cut",
          "language_unit_ids": [
            "LU-E-2022-2216618-012"
          ]
        }
      ]
    }
  ],
  "organization_logic": {
    "positive_artifacts_status": "complete",
    "weakness_substitution_allowed": false,
    "global_organization_chain": [
      "Accuse the plan of chasing profit, then name a model that is only money",
      "Set the seed carbon to zero, and call the curve Chapman-Richards",
      "Put the harvest age between the product life and the tree life",
      "Draw two pies, and let biodiversity, not carbon, dominate the developed one",
      "Read a rising curve as a ban",
      "Ask the reader whether the harvest is still bad"
    ],
    "main_argument_chains": [
      {
        "claim": "Stand carbon follows a Chapman-Richards curve, thinned by the ratio of life to harvest age, and products add a factor of 8.674 years. Tropical and temperate carbon peak at 59.90 years; the frigid peak is 63.45. Aspen, with a 55-year life and a developed-country pie that puts biodiversity at 57.14 percent, is left uncut. Brazil, with economy at 59.36 percent, is told to cut at 134.15 years, while the newspaper says 59.9.",
        "support_steps": [
          "Solve the synthesis-minus-destruction rate and thin the stand by life over age",
          "Add product carbon with lives 35, 25, and 2 years",
          "Weight carbon, money, and biodiversity separately for developed and developing countries",
          "Leave aspen uncut because the index is still rising at 55 years",
          "Move Brazil from a stated current age of 173.70 years by ten years, and price the loss at 4.754 percent"
        ],
        "decision_consequence": "Leave the short-lived temperate stand uncut, and cut the tropical stand on a long rotation.",
        "source_pages": [
          11,
          14,
          17,
          19,
          25
        ]
      }
    ],
