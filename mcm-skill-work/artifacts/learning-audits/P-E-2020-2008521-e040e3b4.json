  "main_argument_chains": [
   {
    "claim": "a safe production is the sum of what industry recycles, what burning removes and what soil and ocean degrade",
    "support_steps": [
     "split the waste into three named paths",
     "scale the first two by the annual production",
     "degrade the two existing stocks"
