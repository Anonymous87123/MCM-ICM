  "organization_logic": {
    "positive_artifacts_status": "complete",
    "weakness_substitution_allowed": false,
    "global_organization_chain": [
      "Name the asset and its growing role before any method.",
      "Concede the missing operating data before introducing the model that replaces it.",
      "Fix the matrix convention once, then derive each twin indicator by a single named substitution.",
      "Gloss every indicator in words before displaying its formula.",
      "Report each result as a before, an after and the cut, and bound the evidence in the same section that credits the model."
    ],
    "section_progressions": [
      {
        "chapter": "abstract",
        "positive_pattern": "a data asset whose role is growing",
        "moves": [
          "input: a data asset whose role is growing",
          "rhetorical job: raise the asset, then close each session on a number",
          "analytical job: report the network size, the score and the delay cut",
          "output: the four-session summary",
          "handoff: the background explains why no operating data exists"
        ]
      },
      {
        "chapter": "introduction",
        "positive_pattern": "a system the question gives no data for",
        "moves": [
          "input: a system the question gives no data for",
          "rhetorical job: concede the missing data before announcing the model",
          "analytical job: commit to a document-built network, simulated indicators and a copied net",
          "output: the plan and the letter preview",
          "handoff: the assumption list states what the plan rests on"
        ]
      },
      {
        "chapter": "assumptions",
        "positive_pattern": "the simplifications the network and the net need",
        "moves": [
          "input: the simplifications the network and the net need",
          "rhetorical job: state each one bare, with only and no conflict doing the work",
          "analytical job: freeze the business, close the cause list, license one firm, drop disagreement",
          "output: four unjustified assumptions",
          "handoff: the notation table names the symbols those assumptions allow"
        ]
      },
      {
        "chapter": "notation",
        "positive_pattern": "the symbols the formulas will use",
        "moves": [
          "input: the symbols the formulas will use",
          "rhetorical job: hand them to one table in a single sentence",
          "analytical job: collect every symbol",
          "output: the symbol table",
          "handoff: the meta-network section uses the symbols"
        ]
      },
      {
        "chapter": "model-establishment",
        "positive_pattern": "the four kinds of element",
        "moves": [
          "input: the four kinds of element",
          "rhetorical job: credit the borrowed concept, fix the arithmetic once, then gloss each indicator before its formula",
          "analytical job: build the network, compute the indicators, compress them, score one firm",
          "output: the ratio 0.8514 and the repair list",
          "handoff: the petri net section inherits the network's links"
        ]
      },
      {
        "chapter": "model-improvement",
        "positive_pattern": "the inherited links and the detention time",
        "moves": [
          "input: the inherited links and the detention time",
          "rhetorical job: define the net as a tuple, check it, then diff the optimized net against it",
          "analytical job: solve the balance and divide the token count by the throughput",
          "output: the delay cut from 140.167 to 85.980 minutes",
          "handoff: the sensitivity section asks whether the cut is stable"
        ]
      },
      {
        "chapter": "sensitivity-analysis",
        "positive_pattern": "the finished score and the finished net",
        "moves": [
          "input: the finished score and the finished net",
          "rhetorical job: enumerate the scenarios, contrast the extreme with the flat case, then hedge the agreement",
          "analytical job: delete nodes and sweep two rates",
          "output: the agreement with the example firm and the fitted surface",
          "handoff: the recommendations section turns both into advice"
        ]
      },
      {
        "chapter": "results",
        "positive_pattern": "the score, the cut and the client's brief",
        "moves": [
          "input: the score, the cut and the client's brief",
          "rhetorical job: license the advice with a verdict, then give the one action the firm must take",
          "analytical job: state the operating instruction and the five transfer steps",
          "output: the instruction and the cross-industry procedure",
          "handoff: the strengths section credits the same models"
        ]
      },
      {
        "chapter": "strengths-limitations",
        "positive_pattern": "the finished pair of models",
        "moves": [
          "input: the finished pair of models",
          "rhetorical job: credit each model for one property, then bound the evidence",
          "analytical job: state four strengths and two limits",
          "output: the portability claim and the two concessions",
          "handoff: the letter carries the verdict to the client"
        ]
      },
