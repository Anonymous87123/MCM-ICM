    "main_argument_chains": [
      {
        "claim": "A port data-and-analytics system can be scored by twelve matrix indicators compressed into one ratio against a standard network.",
        "support_steps": [
          "Thirty-three nodes and 199 links are read from documents into nine sub-networks.",
          "Twelve indicators are computed as matrix operations, six of them by swapping networks.",
          "Fifty random deletions feed a component analysis whose weighted sum is the score."
        ],
        "decision_consequence": "Mediterranean Shipping Company scores 0.8514 and is told to strengthen customs release and in-port consolidation information.",
        "source_pages": [
          6,
          9,
          13
        ]
      },
      {
        "claim": "Copying the meta-network into a stochastic Petri net lets the detention time be computed and then cut.",
        "support_steps": [
          "Places, transitions and links are inherited from the meta-network.",
          "The mean delay is the mean token count divided by the throughput, giving 140.167 minutes.",
          "Running three transitions in parallel and replacing the manual check lowers it to 85.980 minutes."
        ],
        "decision_consequence": "The firm is told the equipment waits 38.7 percent less, 54.187 minutes.",
        "source_pages": [
          15,
          18,
          19
        ]
      }
