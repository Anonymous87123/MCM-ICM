  "main_argument_chains": [
   {
    "claim": "a national equivalent table can value a region once it is corrected by the local quality over the national average",
    "support_steps": [
     "take the area times the coefficient",
     "divide the local quality by the national average",
     "anchor the unit to the net profit of three crops"
    ],
    "decision_consequence": "read the corrected product as the region's service value",
    "source_pages": [
     6,
     9
