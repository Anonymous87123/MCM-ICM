        {
          "paragraph_index": 1,
          "dominant_move": "Call the forest the lungs of the earth before the question",
          "language_unit_ids": [
            "LU-E-2022-2223269-001"
          ]
        },
        {
          "paragraph_index": 2,
          "dominant_move": "Separate the living forest from its products",
