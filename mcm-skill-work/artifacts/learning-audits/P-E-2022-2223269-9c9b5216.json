    "main_argument_chains": [
      {
        "claim": "Product carbon is about one-fifth of living-forest carbon and stays for nearly the whole life cycle, so a plan that cuts is preferred to a ban. After a collinear regression is rebuilt, forest carbon next year is 0.999 of this year, and a network with correlation 0.95833 estimates the stock. Applied to Jindong Forest, the store reaches 450.003 teragrams by 2120, and a five-stage plan cuts 9343.32 square meters and 2580341.86 cubic meters, with timber weighted at 0.588.",
        "support_steps": [
          "Separate the living forest from its products and convert volume with the IPCC factors",
          "Drop the collinear drivers and keep the lagged store",
          "Average the three product accounts when no rule chooses",
          "Weight carbon, water, soil, and timber, and cap the cut by slope",
          "Project Jindong to 2120 and solve the plan in LINGO"
        ],
        "decision_consequence": "Cut some mature stands, keep the selective intensity under 40 percent when the best cycle is longer, and tell readers that cutting nothing is not the best plan.",
        "source_pages": [
          7,
          10,
          14,
          18
        ]
      }
    ],
