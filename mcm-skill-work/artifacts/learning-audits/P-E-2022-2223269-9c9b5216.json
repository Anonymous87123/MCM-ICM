            "LU-E-2022-2223269-004"
          ]
        },
        {
          "paragraph_index": 5,
          "dominant_move": "Name the three services the regression kept",
          "language_unit_ids": [
            "LU-E-2022-2223269-005"
          ]
        },
        {
          "paragraph_index": 6,
          "dominant_move": "Name the forest, then the century total",
          "language_unit_ids": [
            "LU-E-2022-2223269-006"
          ]
        },
        {
          "paragraph_index": 7,
          "dominant_move": "Pair the cut area with the cut volume",
          "language_unit_ids": [
            "LU-E-2022-2223269-007"
          ]
        },
        {
          "paragraph_index": 8,
          "dominant_move": "Translate the place name in the summary",
          "language_unit_ids": [
            "LU-E-2022-2223269-069"
          ]
        }
      ]
    },
