    "main_argument_chains": [
      {
        "claim": "An insurer covers Queensland, Western Australia, the Philippines, and Thailand, where premiums run from 119.20 to 1295.62 dollars; the same risk tells a developer which sites can be rescued; and it leaves the Temple of Literature, scored at 0.463, to be protected rather than insured.",
        "support_steps": [
          "Forecast each area and hazard with its own autoregressive model",
          "Price the cover by adding Lane's loading to the expected loss",
          "Keep the areas that maximize demand minus risk",
          "Adjust a site's risk by distance, strength, or water efficiency",
          "Score the uninsured landmark on eight indicators and band it"
        ],
        "decision_consequence": "Underwrite four of the eight areas, build only where the adjusted risk falls, and give the temple moderate protection.",
        "source_pages": [
          6,
          10,
          16,
          21
        ]
      }
    ],
