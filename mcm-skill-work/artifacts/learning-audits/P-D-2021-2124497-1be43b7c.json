    "main_argument_chains": [
      {
        "claim": "An influence edge carries three kinds of information, and their product is the weight.",
        "support_steps": [
          "count decade pairs",
          "count genre pairs",
          "take the out-degree",
          "multiply",
          "show one fraction"
        ],
        "decision_consequence": "A bare edge would have treated every influence as equal, which the three shares exist to avoid.",
        "source_pages": [
          4,
          5,
          6,
          7
        ]
      },
      {
        "claim": "Similarity should be an expectation over many small views, not one projection.",
        "support_steps": [
          "drop the non-musical field",
          "draw random triples",
          "score each",
          "take the expectation",
          "compare the distributions by Bayes error"
        ],
        "decision_consequence": "One projection would have discarded the interactions the method was chosen to keep.",
        "source_pages": [
          8,
          9,
          10
        ]
      },
      {
        "claim": "A revolutionary artist influences many and is influenced by few, and the definition predicts a measurable drop.",
        "support_steps": [
          "state the definition",
          "compute both closenesses",
          "rank",
          "redefine similarity around the center",
          "observe the predicted fall"
        ],
        "decision_consequence": "Without the predicted shift the ranking would be an untested definition.",
        "source_pages": [
          3,
          14,
          21
        ]
      }
    ]
