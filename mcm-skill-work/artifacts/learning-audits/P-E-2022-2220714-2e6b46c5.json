      "paragraphs": [
        {
          "paragraph_index": 1,
          "dominant_move": "Open on the gas, then the rate",
          "language_unit_ids": [
            "LU-E-2022-2220714-008"
          ]
        },
        {
          "paragraph_index": 2,
          "dominant_move": "Give the forest its share of the exchange",
          "language_unit_ids": [
            "LU-E-2022-2220714-009"
          ]
        },
        {
          "paragraph_index": 3,
          "dominant_move": "Say a ban will not win",
          "language_unit_ids": [
            "LU-E-2022-2220714-010"
          ]
        },
        {
          "paragraph_index": 4,
