        },
        {
          "paragraph_index": 2,
          "dominant_move": "Call the forest the lung of the earth",
          "language_unit_ids": [
            "LU-E-2022-2220714-002"
          ]
        },
        {
          "paragraph_index": 3,
          "dominant_move": "Name the model by its three pools",
          "language_unit_ids": [
            "LU-E-2022-2220714-003"
          ]
        },
        {
          "paragraph_index": 4,
          "dominant_move": "Give the carbon plan as one pair",
          "language_unit_ids": [
            "LU-E-2022-2220714-004"
          ]
        },
        {
          "paragraph_index": 5,
          "dominant_move": "Quote the cut against the ban",
          "language_unit_ids": [
            "LU-E-2022-2220714-005"
          ]
        },
        {
          "paragraph_index": 6,
          "dominant_move": "Lengthen the plan once value is added",
          "language_unit_ids": [
            "LU-E-2022-2220714-006"
          ]
        },
        {
          "paragraph_index": 7,
          "dominant_move": "Let the forest type move the plan",
          "language_unit_ids": [
            "LU-E-2022-2220714-007"
          ]
        },
        {
          "paragraph_index": 8,
          "dominant_move": "Misname the second model",
          "language_unit_ids": [
            "LU-E-2022-2220714-065"
          ]
        }
      ]
    },
    {
      "chapter": "introduction",
      "visual_paragraph_count": 4,
