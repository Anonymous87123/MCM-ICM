  "organization_logic": {
    "positive_artifacts_status": "complete",
    "weakness_substitution_allowed": false,
    "global_organization_chain": [
      "Call the forest the lung of the earth, then say it needs to be cut",
      "Split the carbon into the living tree, the product, and the dead wood",
      "Cut the old tree, and plant one for each tree taken",
      "Weigh the values by how many papers a search returns",
      "Let the forest type move the plan from a long light cut to a short heavy one",
      "Ask whether the forest should be protected without logging, and answer that the answer is not perfect"
    ],
    "main_argument_chains": [
      {
        "claim": "Living trees, products, and dead wood are counted apart. On a Changbai plot of ten thousand square meters the carbon plan is a 10-year rotation that cuts 20 percent of the mature stand, and it stores 3.57 times 10 to the 10 grams of CO2 in 100 years against 3.09 with no cut. Once tourism and cost are scored, the best plan lengthens to 15 years and 40 percent, and a no-cut plan scores lowest. An ornamental forest wants the long, light cut, and an economic forest wants the short, heavy one.",
        "support_steps": [
          "Measure living carbon with a light-use model and let productivity fall after maturity",
          "Keep product carbon on three clocks and halve the dead store each year",
          "Cut only mature trees, on a rotation, and replant one for one",
          "Weigh ecology, economy, and tourism, and score the plans",
          "Move the winner when the forest changes from ornamental to economic"
        ],
        "decision_consequence": "Cut the mature stand, lengthen the wait when tourism matters, and do not leave the forest uncut.",
        "source_pages": [
          14,
          16,
          18,
          22
        ]
      }
    ],
