    "global_organization_chain": [
      "Name the model by three letters and give the first two the same job",
      "Add five pools, then let the product forget which year it started",
      "Grow the area up to the country, and give the rate a sign without a coefficient",
      "Cut the fast tree and keep the slow one for its lignin",
      "Call a crossing a transition, and show a forest that never crosses",
      "Doubt the ban, then keep the twenty-five-year cycle"
    ],
    "main_argument_chains": [
      {
        "claim": "Carbon per hectare is five pools plus a product stock, and area is a logistic. The score weights are 33.41, 32.56, 10.85, 16.11, and 7.07 percent. Bach Ma, printed at about 22,000 square kilometers, stores 1.68 times 10 to the 7 tonnes over 100 years. A 25-year cycle meets the old score in 2036 and reaches 70 in 42 years. A ten-year test of the same park puts the meeting between 2040 and 2045, and the nitrogen figures fall as the cycle grows.",
        "support_steps": [
          "Add the pools and decay the products from 2020, then again from 0",
          "Fit the area rate to deforestation, latitude, and GDP, and print only the signs",
          "Weight carbon, fertility, diversity, money, and tourists",
          "Scale the nitrogen gradient by the ratio of the two cycles",
          "Choose 25 years because 70 arrives sooner than at 50 years and the late paths match"
        ],
        "decision_consequence": "Lengthen the fir cycle to 25 years, and do not expect every forest to show a transition.",
        "source_pages": [
          11,
          13,
          17,
          21,
          22
        ]
      }
    ],
