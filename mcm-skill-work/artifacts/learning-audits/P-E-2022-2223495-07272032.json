  "paragraph_chains": [
    {
      "chapter": "abstract",
      "visual_paragraph_count": 6,
      "coverage_status": "complete",
      "gaps": [],
      "paragraphs": [
        {
          "paragraph_index": 1,
          "dominant_move": "Name the policy slogan before the question",
          "language_unit_ids": [
            "LU-E-2022-2223495-001"
          ]
        },
        {
          "paragraph_index": 2,
          "dominant_move": "Name the four tools in one sentence",
          "language_unit_ids": [
            "LU-E-2022-2223495-002"
          ]
        },
        {
          "paragraph_index": 3,
          "dominant_move": "State the finding before the number",
          "language_unit_ids": [
            "LU-E-2022-2223495-003"
          ]
        },
        {
          "paragraph_index": 4,
          "dominant_move": "Give the value as a range, not a point",
          "language_unit_ids": [
            "LU-E-2022-2223495-004"
          ]
        },
        {
          "paragraph_index": 5,
          "dominant_move": "Tie the harvest band to the uptake band",
          "language_unit_ids": [
            "LU-E-2022-2223495-005"
          ]
        },
        {
          "paragraph_index": 6,
          "dominant_move": "Name the winner and the exception",
          "language_unit_ids": [
            "LU-E-2022-2223495-006"
          ]
        }
      ]
    },
    {
      "chapter": "introduction",
      "visual_paragraph_count": 5,
      "coverage_status": "complete",
      "gaps": [],
      "paragraphs": [
        {
          "paragraph_index": 1,
          "dominant_move": "Define the method in one clause",
          "language_unit_ids": [
            "LU-E-2022-2223495-007"
          ]
        },
        {
          "paragraph_index": 2,
          "dominant_move": "Credit the forest, then the conflict",
          "language_unit_ids": [
            "LU-E-2022-2223495-008"
          ]
        },
        {
          "paragraph_index": 3,
          "dominant_move": "Stack the treaties before the practice",
          "language_unit_ids": [
            "LU-E-2022-2223495-010"
          ]
        },
        {
          "paragraph_index": 4,
          "dominant_move": "Borrow the recommendation from the review",
          "language_unit_ids": [
            "LU-E-2022-2223495-011"
          ]
        },
        {
