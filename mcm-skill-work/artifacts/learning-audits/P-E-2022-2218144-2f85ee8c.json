  "organization_logic": {
    "positive_artifacts_status": "complete",
    "weakness_substitution_allowed": false,
    "global_organization_chain": [
      "Open on a film line, one tree every hectare",
      "Split the forest into trees, understory, and land, then add the products",
      "Call the forest pool narrow and the forest-plus-product pool broad",
      "Give the bat a memory, so the early search teaches the later one",
      "Score the plan by the length of a vector aimed at (1, 1, 1)",
      "Say a ban on cutting is not the best plan, and ask for help"
    ],
    "main_argument_chains": [
      {
        "claim": "Forest carbon is trees, understory, and land, and harvested wood is a second pool. On Russia the bat chooses a cut of 0.0105 percent and a planting of 0.3 percent. On China a five-year ban does not hold the 2020 score: the isosurface falls from 0.9689 to 0.8716. On Sudan the plan is a 0.21 percent cut and a 2.33 percent planting, and the body, not the summary, is what the 42.09-fold increase matches.",
        "support_steps": [
          "Convert stock to carbon and grow the area by the cut and the planting",
          "Decay the product pool and add the new inflow",
          "Search the rates with a bat whose speed remembers the last step",
          "Weight twelve indicators by entropy and take the length of the score vector",
          "Move Sudan off a 2.25 percent cut with no planting"
        ],
        "decision_consequence": "Cut a little, plant more, and do not ban the harvest.",
        "source_pages": [
          11,
          18,
          20,
          21
        ]
      }
    ],
