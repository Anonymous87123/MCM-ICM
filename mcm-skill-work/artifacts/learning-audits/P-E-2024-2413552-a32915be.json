  "paragraph_chains": [
    {
      "chapter": "abstract",
      "visual_paragraph_count": 6,
      "coverage_status": "complete",
      "gaps": [],
      "paragraphs": [
        {
          "paragraph_index": 1,
          "dominant_move": "Open on the global trend before naming the industry it hurts",
          "language_unit_ids": [
            "LU-E-2024-2413552-001"
          ]
        },
        {
          "paragraph_index": 2,
          "dominant_move": "Name the model and the three data streams it joins",
          "language_unit_ids": [
            "LU-E-2024-2413552-002"
          ]
        },
        {
          "paragraph_index": 3,
          "dominant_move": "State the gain of the method in one clause",
          "language_unit_ids": [
            "LU-E-2024-2413552-003"
          ]
        },
        {
          "paragraph_index": 4,
          "dominant_move": "Give one place both its present and its future number",
          "language_unit_ids": [
            "LU-E-2024-2413552-004"
          ]
        },
        {
          "paragraph_index": 5,
          "dominant_move": "Turn the weights into a list of actions",
          "language_unit_ids": [
            "LU-E-2024-2413552-005"
          ]
        },
        {
          "paragraph_index": 6,
          "dominant_move": "Name the landmark, the measures, and the annual cost together",
          "language_unit_ids": [
            "LU-E-2024-2413552-006"
          ]
        }
      ]
    },
    {
      "chapter": "introduction",
      "visual_paragraph_count": 8,
      "coverage_status": "complete",
      "gaps": [],
      "paragraphs": [
        {
          "paragraph_index": 1,
          "dominant_move": "Open with a quotation and then gloss both halves of it",
          "language_unit_ids": [
            "LU-E-2024-2413552-007"
          ]
        },
        {
          "paragraph_index": 2,
          "dominant_move": "Attach a death toll and a dollar loss to the same trend",
          "language_unit_ids": [
            "LU-E-2024-2413552-008"
          ]
        },
        {
          "paragraph_index": 3,
          "dominant_move": "Give the trend three causes in one sentence",
          "language_unit_ids": [
            "LU-E-2024-2413552-009"
          ]
        },
        {
          "paragraph_index": 4,
          "dominant_move": "Promote the question to a turning point",
          "language_unit_ids": [
            "LU-E-2024-2413552-010"
          ]
        },
        {
          "paragraph_index": 5,
          "dominant_move": "Organize the literature as a numbered list of industry responses",
          "language_unit_ids": [
            "LU-E-2024-2413552-013"
          ]
        },
        {
          "paragraph_index": 6,
          "dominant_move": "Cite a small percentage that produces a large effect",
          "language_unit_ids": [
            "LU-E-2024-2413552-014"
          ]
        },
        {
          "paragraph_index": 7,
          "dominant_move": "Declare the old method unreliable and name its replacement",
          "language_unit_ids": [
            "LU-E-2024-2413552-015"
          ]
        },
        {
          "paragraph_index": 8,
          "dominant_move": "Retell the work as three numbered studies",
          "language_unit_ids": [
            "LU-E-2024-2413552-016"
          ]
        }
      ]
    }
