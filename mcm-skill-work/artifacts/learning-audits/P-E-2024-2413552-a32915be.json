  "organization_logic": {
    "positive_artifacts_status": "complete",
    "weakness_substitution_allowed": false,
    "global_organization_chain": [
      "Open with a quotation and gloss both halves before any number",
      "Survey the field as Firstly through Finally with one figure per item",
      "State the trade inside the first numbered task",
      "Give each risk class one place as its example",
      "Order the advice by the weight of the indicator",
      "Close the letter on the symbol rather than the cost"
    ],
    "main_argument_chains": [
      {
        "claim": "A location-specific regression prices property cover so that California rises from about 20 to 31 million dollars by 2034, community protection at roughly 70 percent costs roughly 30 percent, and the Statue of Liberty takes the top tier at about 2.5 million dollars a year.",
        "support_steps": [
          "Cut 96 climate variables to four components",
          "Regress the payout with a coefficient per location",
          "Multiply the base by risk, a humanitarian coefficient, and a profit factor",
          "Add community protection as one more covariate and weight the owner indicators by entropy",
          "Score the landmark and reuse the regression on its features"
        ],
        "decision_consequence": "Hold a low threshold of cover, push community action ahead of owner action, and fund the monument at the top tier.",
        "source_pages": [
          9,
          12,
          16,
          21
        ]
      }
    ],
