      "section": "4 PageRank",
      "family": "network-ranking",
      "purpose": "Score artist influence by a reversed PageRank on the follower graph",
      "base_or_modification": "modification",
      "summary": "Artists are nodes, influence is a directed edge from influencer to follower, and same-genre artists form a subnetwork. The iteration is reversed relative to classical PageRank: value flows from child to parent, split evenly across the parent's incoming links, with a damping factor p usually 0.85. Rankings are reported for the full graph and for Pop/Rock, and stability is argued from the order being unchanged.",
      "algorithm": {
        "status": "implemented",
        "steps": [
          "Build the directed graph",
          "Seed equal values",
          "Push value from child to parent each iteration",
          "Stop when values settle"
        ],
        "software": [
          "not stated"
        ],
        "convergence_criteria": "Values unchanged between iterations"
      },
      "assumptions": [
        "Every follower link carries equal weight"
      ],
      "computational_cost": "Low per iteration",
      "conditions": {
