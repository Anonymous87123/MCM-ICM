      "section": "3.2 Musical Influence",
      "family": "decay-model",
      "purpose": "Model the fading of musical influence as exponential cooling",
      "base_or_modification": "base",
      "summary": "Influence falls the way a hot object cools, fast then slow, and like a hot drink it stays strong through the first decade. The rate of decline is proportional to the gap from the floor. Integrating and setting the floor to zero gives a pure exponential in the elapsed time. The decay constant is chosen by the authors. A smoothing spline on follower counts supplies the delay.",
      "algorithm": {
        "status": "implemented",
        "steps": [
          "Write the proportional rate",
          "Integrate",
          "Set the floor to zero",
          "Fit a smoothing spline to follower counts"
        ],
        "software": [
          "MATLAB"
        ],
        "convergence_criteria": "Closed form"
      },
      "assumptions": [
        "Decay depends on the gap, not the calendar year",
        "The floor is zero"
      ],
      "computational_cost": "Low",
      "conditions": {
        "initial": {
          "status": "present",
          "details": [
            "Influence starts at MI(t0)"
          ]
        },
        "boundary": {
          "status": "not-applicable",
          "details": [
            "No boundary"
          ]
        },
        "equilibrium": {
          "status": "present",
          "details": [
