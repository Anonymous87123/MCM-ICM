          "page": 9,
          "label": "(9)",
          "source_expression": "F[phi(x)] = phi''(x)/(1+phi'(x)^2)",
          "normalized_latex": "F[\\phi(x)]=\frac{\\phi''(x)}{1+(\\phi'(x))^2}",
