          "page": 8,
          "label": "(1)",
          "source_expression": "dE = -mu N ds = -mu N sqrt(1+phi'^2) dx",
          "normalized_latex": "dE=-\\mu N\\,ds=-\\mu N\\sqrt{1+(\\phi')^2}\\,dx",
          "purpose": "State frictional energy loss.",
          "variable_symbols": [
            "E",
            "mu",
            "N",
            "phi",
            "x"
