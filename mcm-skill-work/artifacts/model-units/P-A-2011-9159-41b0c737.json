          "page": 8,
          "label": "(3)",
          "source_expression": "1/rho = phi''/(1+phi'^2)^(3/2)",
          "normalized_latex": "\frac1\rho=\frac{\\phi''}{(1+(\\phi')^2)^{3/2}}",
