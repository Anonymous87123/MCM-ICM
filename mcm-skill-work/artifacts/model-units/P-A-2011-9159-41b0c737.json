        {
          "equation_id": "EQ-A-2011-9159-007",
          "page": 9,
          "label": "(7)",
          "source_expression": "E0[phi]=mgy0+mg(h-y0) phi'(x0)^2/(1+phi'(x0)^2)",
          "normalized_latex": "E_0[\\phi]=mgy_0+mg(h-y_0)\frac{(\\phi'(x_0))^2}{1+(\\phi'(x_0))^2}",
          "purpose": "Set post-collision initial energy.",
