          "label": "(10)",
          "source_expression": "integral phi''/(1+phi'^2) ds = theta(t)-theta(x0)",
          "normalized_latex": "\\int_{x_0}^{t}\frac{\\phi''}{1+(\\phi')^2}ds=\theta(t)-\theta(x_0)",
