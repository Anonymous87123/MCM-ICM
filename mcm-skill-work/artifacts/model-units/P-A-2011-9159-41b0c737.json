          "page": 9,
          "label": "(5)",
          "source_expression": "dE/dx + [2 mu phi''/(1+phi'^2)]E = -mu mg[1-2 phi phi''/(1+phi'^2)]",
          "normalized_latex": "\frac{dE}{dx}+\frac{2\\mu\\phi''}{1+(\\phi')^2}E=-\\mu mg\\left(1-\frac{2\\phi\\phi''}{1+(\\phi')^2}\right)",
          "purpose": "Obtain the profile-dependent energy ODE.",
