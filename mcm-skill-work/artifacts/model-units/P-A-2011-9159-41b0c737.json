        {
          "equation_id": "EQ-A-2011-9159-002",
          "page": 8,
          "label": "(2)",
          "source_expression": "N = mg cos(theta) + m v^2/rho",
          "normalized_latex": "N=mg\\cos\theta+\frac{mv^2}{\rho}",
          "purpose": "Combine gravity-normal and centripetal force.",
