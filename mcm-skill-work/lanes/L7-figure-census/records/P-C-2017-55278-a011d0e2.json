  "\u7b26\u53f7\u8868\u662f\u552f\u4e00\u4e0d\u7f16\u53f7\u3001\u4e0d\u7ed9\u9898\u6ce8\u7684\u8868\uff1a\u5b83\u7d27\u63a5 2.2 Notations \u6807\u9898\u6392\u4e0b\uff0c\u7b2c\u4e00\u884c\u5c31\u662f Symbol/Meaning \u680f\u5934\uff08[table.header_rows]=1\u3001[caption.numbering]=none\uff09\uff0c25 \u884c\u7b26\u53f7\u53ea\u7ed9\u542b\u4e49\u4e0d\u7ed9\u53d6\u503c\uff08[table.rows]=26\u3001[table.cols]=2\uff09\u3002",
  "\u8868\u7684\u89c4\u6a21\u7531\u901f\u5ea6\u53d6\u503c\u4e2a\u6570\u51b3\u5b9a\uff1a\u680f\u9996\u5217\u662f\u7b26\u53f7\uff08v\u3001Pa\u3001Pd\uff09\uff0c\u540e\u63a5 7 \u4e2a\u901f\u5ea6\u5217\uff0c\u6240\u4ee5\u662f 3 \u884c 8 \u5217\uff08[table.rows]=3\u3001[table.cols]=8\uff09\uff0c\u800c\u4e0d\u662f\u6309\u5de5\u51b5\u5206\u884c\u3002",
  "\u8868\u7684\u5355\u4f4d\u4e0d\u8fdb\u8868\u5934\uff08[table.units_in_header]=False\uff09\uff0c\u6982\u7387\u662f\u65e0\u91cf\u7eb2\u7eaf\u6570\u3001\u901f\u5ea6\u7531\u680f\u9996\u5217\u7b26\u53f7\u9690\u542b\uff0c\u6240\u4ee5 Table 1 \u662f\u5168\u7bc7\u552f\u4e00\u4e0d\u5199\u5355\u4f4d\u4e5f\u4e0d\u5199\u8868\u6ce8\u7684\u8868\uff08[table.note_sentence] \u4e3a\u7a7a\u4e32\uff09\u3002",
  "\u7248\u9762\u5bbd\u5ea6\u6309\u201c\u56fe\u6210\u5bf9/\u5355\u5f20\u201d\u4e24\u6863\uff1a\u5e76\u6392\u4e24\u534a\u5404\u5360\u7248\u5fc3\u4e00\u534a\uff0c\u5355\u5f20\u56fe\u5360\u6ee1\u7248\u5fc3\uff0c[place.area_frac] \u5728 Fig. 4 \u4e0e Fig. 12 \u4e0a\u6b63\u597d\u5dee\u4e00\u500d\u3002",
  "\u56fe\u8868\u4e0e\u8282\u7684\u5bf9\u5e94\u662f\u201c\u4e00\u8282\u4e00\u5bf9\u201d\uff1a3.x \u7684\u6548\u679c\u8282\u6bcf\u8282\u4e00\u5bf9\uff08\u6574\u65e5/\u9ad8\u5cf0\uff09\uff0c4.1.x \u7684\u5b9e\u6d4b\u8282\u4e5f\u6309\u540c\u6837\u7684\u6574\u65e5-\u9ad8\u5cf0\u914d\u6210\u5bf9\u6216\u5355\u5f20\uff0c[place.section_path] \u9010\u6761\u8bb0\u5230\u5c0f\u8282\u7ea7\u3002",
